NODE_ENV=development
PORT=5001
BACKEND_PORT=5001
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# Application PostgreSQL Database
APP_DATABASE_URL=postgresql://username:password@localhost:5432/sqlsense
DATABASE_URL=postgresql://username:password@localhost:5432/sqlsense

# Security & Encryption
JWT_SECRET=your_jwt_secret_key_here
