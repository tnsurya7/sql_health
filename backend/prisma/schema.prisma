datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}

model DatabaseConnection {
  id         String   @id @default(uuid())
  name       String
  host       String
  port       Int
  database   String
  username   String
  password   String
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  queries           SqlQuery[]
  metadata          DatabaseMetadata[]
  recommendations   Recommendation[]
  healthScores      HealthScore[]
  performanceMetrics PerformanceMetric[]
}

model DatabaseMetadata {
  id           String             @id @default(uuid())
  connectionId String
  connection   DatabaseConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  schemaName   String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tables       TableMetadata[]

  @@unique([connectionId, schemaName])
}

model TableMetadata {
  id         String           @id @default(uuid())
  metadataId String
  metadata   DatabaseMetadata @relation(fields: [metadataId], references: [id], onDelete: Cascade)
  tableName  String
  rowCount   Int              @default(0)
  sizeBytes  BigInt           @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  columns ColumnMetadata[]
  indexes IndexMetadata[]

  @@unique([metadataId, tableName])
}

model ColumnMetadata {
  id         String        @id @default(uuid())
  tableId    String
  table      TableMetadata @relation(fields: [tableId], references: [id], onDelete: Cascade)
  columnName String
  dataType   String
  isNullable Boolean
  isPk       Boolean       @default(false)
  isFk       Boolean       @default(false)
  fkRefTable String?
  fkRefCol   String?
  defaultVal String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([tableId, columnName])
}

model IndexMetadata {
  id          String        @id @default(uuid())
  tableId     String
  table       TableMetadata @relation(fields: [tableId], references: [id], onDelete: Cascade)
  indexName   String
  indexDef    String
  columns     String[]
  isUnique    Boolean       @default(false)
  isPrimary   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([tableId, indexName])
}

model SqlQuery {
  id           String             @id @default(uuid())
  connectionId String?
  connection   DatabaseConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  rawSql       String
  formattedSql String?
  score        Int                @default(100)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  analyses       QueryAnalysis[]
  benchmarks     PerformanceMetric[]
  optimizations  OptimizationResult[]
  history        QueryHistory[]
}

model QueryAnalysis {
  id          String    @id @default(uuid())
  queryId     String
  query       SqlQuery  @relation(fields: [queryId], references: [id], onDelete: Cascade)
  summary     String
  scorePerf   Int
  scoreSec    Int
  scoreMaint  Int
  scoreOpt    Int
  scoreOver   Int
  createdAt   DateTime  @default(now())

  issues      QueryIssue[]
  plans       ExecutionPlan[]
}

model QueryIssue {
  id             String        @id @default(uuid())
  analysisId     String
  analysis       QueryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  ruleId         String
  title          String
  description    String
  severity       String        // CRITICAL, HIGH, MEDIUM, LOW, INFO
  category       String
  evidence       String
  recommendation String
  confidence     Float
  createdAt      DateTime      @default(now())
}

model ExecutionPlan {
  id           String        @id @default(uuid())
  analysisId   String
  analysis     QueryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  planJson     String        // JSON execution plan string
  planningTime Float?
  executionTime Float?
  createdAt    DateTime      @default(now())
}

model OptimizationResult {
  id             String    @id @default(uuid())
  queryId        String
  query          SqlQuery  @relation(fields: [queryId], references: [id], onDelete: Cascade)
  optimizedSql   String
  aiExplanation  String
  risks          String[]
  confidence     Float
  createdAt      DateTime  @default(now())
}

model Recommendation {
  id           String             @id @default(uuid())
  connectionId String
  connection   DatabaseConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  category     String             // PERFORMANCE, SECURITY, INDEXES, QUALITY, MAINTAINABILITY, DESIGN
  severity     String             // CRITICAL, HIGH, MEDIUM, LOW, INFO
  status       String             @default("NEW") // NEW, REVIEWED, ACCEPTED, REJECTED, APPLIED
  title        String
  description  String
  evidence     String?
  suggestedSql String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model PerformanceMetric {
  id           String              @id @default(uuid())
  connectionId String?
  connection   DatabaseConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  queryId      String?
  query        SqlQuery?           @relation(fields: [queryId], references: [id], onDelete: Cascade)
  label        String?             // e.g. "Original", "Optimized"
  minTimeMs    Float
  maxTimeMs    Float
  avgTimeMs    Float
  medianTimeMs Float
  planningTime Float?
  cost         Float?
  rowsProcessed Int?
  iterations   Int
  createdAt    DateTime            @default(now())
}

model HealthScore {
  id           String             @id @default(uuid())
  connectionId String
  connection   DatabaseConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  scorePerf    Int
  scoreSec     Int
  scoreMaint   Int
  scoreIdx     Int
  scoreSchema  Int
  scoreQuery   Int
  scoreOver    Int
  createdAt    DateTime           @default(now())
}

model QueryHistory {
  id         String   @id @default(uuid())
  queryId    String
  query      SqlQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  status     String   // ANALYZED, OPTIMIZED, BENCHMARKED
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}
