datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}

model DatabaseConnection {
  id              String   @id @default(uuid())
  name            String
  databaseType    String   @default("postgresql") // postgresql, mysql, oracle, sqlserver
  host            String
  port            Int
  database        String
  schema          String   @default("public")
  username        String
  password        String   // Encrypted at application level (AES-256-GCM)
  ssl             Boolean  @default(false)
  readOnly        Boolean  @default(true)
  isActive        Boolean  @default(false)
  status          String   @default("DISCONNECTED") // ONLINE, DISCONNECTED, ERROR, TIMEOUT, AUTH_FAILED
  lastCheckedAt   DateTime?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  queries             SqlQuery[]
  metadata            DatabaseMetadata[]
  recommendations     Recommendation[]
  healthScores        HealthScore[]
  performanceMetrics  PerformanceMetric[]
  deadlockLogs        DeadlockLog[]
  optimizationRuns    OptimizationRun[]
}

model DatabaseMetadata {
  id           String             @id @default(uuid())
  connectionId String
  connection   DatabaseConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  schemaName   String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tables       TableMetadata[]

  @@unique([connectionId, schemaName])
}

model TableMetadata {
  id         String           @id @default(uuid())
  metadataId String
  metadata   DatabaseMetadata @relation(fields: [metadataId], references: [id], onDelete: Cascade)
  tableName  String
  rowCount   Int              @default(0)
  sizeBytes  BigInt           @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  columns ColumnMetadata[]
  indexes IndexMetadata[]

  @@unique([metadataId, tableName])
}

model ColumnMetadata {
  id         String        @id @default(uuid())
  tableId    String
  table      TableMetadata @relation(fields: [tableId], references: [id], onDelete: Cascade)
  columnName String
  dataType   String
  isNullable Boolean
  isPk       Boolean       @default(false)
  isFk       Boolean       @default(false)
  fkRefTable String?
  fkRefCol   String?
  defaultVal String?
  distinctValues Int?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([tableId, columnName])
}

model IndexMetadata {
  id          String        @id @default(uuid())
  tableId     String
  table       TableMetadata @relation(fields: [tableId], references: [id], onDelete: Cascade)
  indexName   String
  indexDef    String
  columns     String[]
  isUnique    Boolean       @default(false)
  isPrimary   Boolean       @default(false)
  indexType   String        @default("BTREE") // BTREE, HASH, GIN, GIST
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([tableId, indexName])
}

model SqlQuery {
  id           String             @id @default(uuid())
  connectionId String?
  connection   DatabaseConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  rawSql       String
  formattedSql String?
  fingerprint  String?
  score        Int                @default(100)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  analyses       QueryAnalysis[]
  benchmarks     PerformanceMetric[]
  optimizations  OptimizationResult[]
  history        QueryHistory[]
  optimizationRuns OptimizationRun[]
}

model QueryFingerprint {
  id             String   @id @default(uuid())
  fingerprint    String   @unique
  normalizedSql  String
  databaseType   String   @default("postgresql")
  executionCount Int      @default(1)
  avgLatencyMs   Float    @default(0)
  minLatencyMs   Float    @default(0)
  maxLatencyMs   Float    @default(0)
  p95LatencyMs   Float    @default(0)
  p99LatencyMs   Float    @default(0)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model QueryAnalysis {
  id          String    @id @default(uuid())
  queryId     String
  query       SqlQuery  @relation(fields: [queryId], references: [id], onDelete: Cascade)
  summary     String
  scorePerf   Int
  scoreSec    Int
  scoreMaint  Int
  scoreOpt    Int
  scoreOver   Int
  createdAt   DateTime  @default(now())

  issues      QueryIssue[]
  plans       ExecutionPlan[]
}

model QueryIssue {
  id             String        @id @default(uuid())
  analysisId     String
  analysis       QueryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  ruleId         String        // R001 to R025
  title          String
  description    String
  severity       String        // CRITICAL, HIGH, MEDIUM, LOW, INFO
  category       String
  evidence       String
  recommendation String
  confidence     Float
  affectedTables String[]      @default([])
  affectedColumns String[]     @default([])
  databaseType   String        @default("postgresql")
  createdAt      DateTime      @default(now())
}

model ExecutionPlan {
  id            String        @id @default(uuid())
  analysisId    String
  analysis      QueryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  planJson      String        // JSON execution plan string
  planningTime  Float?
  executionTime Float?
  totalCost     Float?
  planRows      Float?
  actualRows    Float?
  cardinalityErrorRatio Float?
  expensiveNodes String?      // JSON summary of bottleneck nodes
  createdAt     DateTime      @default(now())
}

model OptimizationResult {
  id             String    @id @default(uuid())
  queryId        String
  query          SqlQuery  @relation(fields: [queryId], references: [id], onDelete: Cascade)
  optimizedSql   String
  aiExplanation  String
  risks          String[]
  confidence     Float
  createdAt      DateTime  @default(now())
}

model OptimizationRun {
  id                  String   @id @default(uuid())
  queryId             String?
  query               SqlQuery? @relation(fields: [queryId], references: [id], onDelete: SetNull)
  connectionId        String?
  connection          DatabaseConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  originalSql         String
  databaseType        String   @default("postgresql")
  selectedCandidateId String?
  summary             String?
  status              String   @default("COMPLETED")
  createdAt           DateTime @default(now())

  candidates          OptimizationCandidateRecord[]
}

model OptimizationCandidateRecord {
  id                   String          @id @default(uuid())
  runId                String
  run                  OptimizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  candidateSql         String
  source               String          // RULE_ENGINE, RELATIONAL_ALGEBRA, DP_JOIN, INDEX_ADVISOR, GEMINI_RAG
  changes              String          // JSON array of changes
  estimatedCost        Float?
  actualLatencyMs      Float?
  isValid              Boolean         @default(false)
  validationReport     String?         // JSON validation output
  benchmarkImprovement Float?          // Measured speedup %
  isWinner             Boolean         @default(false)
  createdAt            DateTime        @default(now())
}

model Recommendation {
  id           String             @id @default(uuid())
  connectionId String
  connection   DatabaseConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  category     String             // PERFORMANCE, SECURITY, INDEXES, QUALITY, MAINTAINABILITY, DESIGN
  severity     String             // CRITICAL, HIGH, MEDIUM, LOW, INFO
  source       String             @default("ALGORITHMIC_RULE") // ALGORITHMIC_RULE, INDEX_ADVISOR, CBO, RAG, AI, MONITORING
  status       String             @default("NEW") // NEW, REVIEWED, ACCEPTED, REJECTED, APPLIED
  title        String
  description  String
  evidence     String?
  suggestedSql String?
  priority     Int                @default(1)
  confidence   Float              @default(1.0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model PerformanceMetric {
  id           String              @id @default(uuid())
  connectionId String?
  connection   DatabaseConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  queryId      String?
  query        SqlQuery?           @relation(fields: [queryId], references: [id], onDelete: Cascade)
  label        String?             // e.g. "Original", "Optimized"
  minTimeMs    Float
  maxTimeMs    Float
  avgTimeMs    Float
  medianTimeMs Float
  p95TimeMs    Float?
  stdDevMs     Float?
  planningTime Float?
  cost         Float?
  rowsProcessed Int?
  iterations   Int
  createdAt    DateTime            @default(now())
}

model HealthScore {
  id           String             @id @default(uuid())
  connectionId String
  connection   DatabaseConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  scorePerf    Int
  scoreSec     Int
  scoreMaint   Int
  scoreIdx     Int
  scoreSchema  Int
  scoreQuery   Int
  scoreOver    Int
  dimensions   String?            // JSON dimension breakdown & weighting
  createdAt    DateTime           @default(now())
}

model DeadlockLog {
  id           String             @id @default(uuid())
  connectionId String
  connection   DatabaseConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  cycleDetails String             // JSON details of wait-for cycle
  resolved     Boolean            @default(false)
  detectedAt   DateTime           @default(now())
}

model OptimizationDocument {
  id           String              @id @default(uuid())
  title        String
  category     String              // INDEXING, SARGABILITY, JOINS, CARDINALITY, REWRITE, SECURITY
  databaseType String              @default("ALL") // ALL, postgresql, mysql, oracle, sqlserver
  source       String
  version      String              @default("1.0")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  chunks       OptimizationChunk[]
}

model OptimizationChunk {
  id             String               @id @default(uuid())
  documentId     String
  document       OptimizationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title          String
  content        String
  keywords       String[]             @default([])
  databaseType   String               @default("ALL")
  category       String
  retrievalCount Int                  @default(0)
  embedding      String?              // Vector / JSON embedding representation
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model QueryHistory {
  id         String   @id @default(uuid())
  queryId    String
  query      SqlQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  status     String   // ANALYZED, OPTIMIZED, BENCHMARKED
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}
